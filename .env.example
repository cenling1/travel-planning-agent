# ============================================
# 智能旅行规划助手 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入真实的 API Key

# ============================================
# 模型 API 密钥（必填）
# ============================================

# DeepSeek API Key - 用于 DeepSeek Chat 和 Reasoner（Agent 全部模型决策）
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_THINKING_ENABLED=false

# DashScope API Key - 仅用于知识库文本 Embedding，不参与 Agent 决策
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# ============================================
# LangChain 配置（可选，用于调试）
# ============================================

# LangChain 追踪开关（true/false）
LANGCHAIN_TRACING_V2=false

# LangChain API Key（如果启用追踪）
# LANGCHAIN_API_KEY=your-langchain-api-key-here

# ============================================
# MCP 配置路径（默认值，一般不需要修改）
# ============================================

# MCP 服务器配置文件路径
MCP_CONFIG_PATH=config/servers_config.json
AGENT_MAX_ROUNDS=3
AGENT_MAX_TOOL_CALLS=12

# ============================================
# 数据库与向量检索
# ============================================

# 不配置 DATABASE_URL 时使用本地 SQLite
# DATABASE_URL=postgresql+psycopg://travel_agent:travel_agent@localhost:5432/travel_agent
UPLOAD_DIR=data/uploads
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# 本地开发默认关闭认证；生产环境请使用 .env.production.example
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=true
JWT_SECRET=
JWT_ISSUER=travel-planning-agent
JWT_AUDIENCE=travel-planning-agent-web
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
RATE_LIMIT_PER_MINUTE=0
MAX_INFLIGHT_REQUESTS=0

# 旧 Chroma 迁移工具使用
CHROMA_PERSIST_DIR=./data/travel_vectordb

# ============================================
# 使用说明
# ============================================
# 1. 复制此文件: cp .env.example .env
# 2. 填入真实的 API Key（替换 sk-your-xxx-key-here）
# 3. 先启动 FastAPI，再启动 frontend-web 中的 Vue 开发服务器
# 4. 注意: .env 文件已被 .gitignore 忽略，不会提交到 Git
