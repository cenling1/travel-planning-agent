# Copy this file to a private server-side .env file. Do not commit real values.

DOMAIN=travel.example.com
# PEM certificate files provisioned by your ACME client or platform.
TLS_CERT_HOST_PATH=/etc/letsencrypt/live/travel.example.com/fullchain.pem
TLS_KEY_HOST_PATH=/etc/letsencrypt/live/travel.example.com/privkey.pem

POSTGRES_DB=travel_agent
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=replace-with-long-random-password

DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_THINKING_ENABLED=false
LLM_EXTRACTION_TIMEOUT_SECONDS=12
LLM_GENERATION_TIMEOUT_SECONDS=75
RAG_TIMEOUT_SECONDS=12
MCP_TIMEOUT_SECONDS=30
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

CORS_ORIGINS=https://travel.example.com
AUTH_ENABLED=true
AUTH_REGISTRATION_ENABLED=false
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=travel-planning-agent
JWT_AUDIENCE=travel-planning-agent-web
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Used only to create the first administrator. Remove both values after first startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
RATE_LIMIT_PER_MINUTE=60
MAX_INFLIGHT_REQUESTS=8
MAX_UPLOAD_BYTES=20971520

# Host path to the private MCP server config. The file is mounted read-only.
MCP_CONFIG_HOST_PATH=/opt/travel-agent/private/servers_config.json
